generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum PartnerType {
  ORGANIZATION
  PERSON
}

enum PartnerRole {
  SUPPLIER
  CUSTOMER
  CARRIER
}

enum ProductConversionMode {
  FIXED
  VARIABLE
}

enum FiscalDocumentStatus {
  PENDING_VALIDATION
  VALIDATION_FAILED
  PENDING_SUPPLIER
  PENDING_MAPPING
  READY_FOR_REVIEW
}

enum FiscalIngestionSource {
  MANUAL_UPLOAD
}

enum FiscalDocumentValidationIssue {
  ORGANIZATION_TAX_ID_NOT_CONFIGURED
  RECIPIENT_TAX_ID_MISMATCH
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(320)
  name         String       @db.VarChar(160)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships  Membership[]
  sessions     Session[]
  auditEvents  AuditEvent[] @relation("AuditActor")

  @@map("users")
}

model Organization {
  id                      String                             @id @default(uuid()) @db.Uuid
  name                    String                             @db.VarChar(160)
  slug                    String                             @unique @db.VarChar(80)
  fiscalTaxId             String?                            @map("fiscal_tax_id") @db.VarChar(32)
  createdAt               DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships             Membership[]
  auditEvents             AuditEvent[]
  idempotencyRecords      IdempotencyRecord[]
  partners                Partner[]
  inboundFiscalItemTaxes  InboundFiscalDocumentItemTax[]
  productAttributeDefs    ProductAttributeDefinition[]
  productAttributeOptions ProductAttributeOption[]
  productAttributes       ProductAttribute[]
  productBrands           ProductBrand[]
  productCategories       ProductCategory[]
  products                Product[]
  productPresentations    ProductPresentation[]
  supplierProductMappings SupplierProductMapping[]
  unitsOfMeasure          UnitOfMeasure[]
  inboundFiscalDocuments  InboundFiscalDocument[]
  inboundFiscalItems      InboundFiscalDocumentItem[]
  fiscalIngestions        FiscalDocumentIngestion[]
  fiscalItemMappings      InboundFiscalDocumentItemMapping[]

  @@map("organizations")
}

model Partner {
  id                      String                   @id @default(uuid()) @db.Uuid
  organizationId          String                   @map("organization_id") @db.Uuid
  type                    PartnerType
  legalName               String                   @map("legal_name") @db.VarChar(160)
  tradeName               String?                  @map("trade_name") @db.VarChar(160)
  taxId                   String                   @map("tax_id") @db.VarChar(32)
  roles                   PartnerRole[]
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplierProductMappings SupplierProductMapping[]

  @@unique([id, organizationId])
  @@unique([organizationId, taxId])
  @@index([organizationId, legalName])
  @@map("partners")
}

model UnitOfMeasure {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  code                 String                @db.VarChar(16)
  name                 String                @db.VarChar(80)
  decimalScale         Int                   @default(4) @map("decimal_scale")
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  baseProducts         Product[]             @relation("ProductBaseUnit")
  productPresentations ProductPresentation[] @relation("PresentationUnit")

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@map("units_of_measure")
}

/// Taxonomia por organizacao. O auto-relacionamento cobre familia, grupo e subgrupo sem exigir
/// uma migration por nivel; a profundidade e os ciclos sao validados no servico.
model ProductCategory {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  parentId       String?           @map("parent_id") @db.Uuid
  code           String            @db.VarChar(40)
  name           String            @db.VarChar(120)
  depth          Int               @default(0)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent         ProductCategory?  @relation("CategoryParent", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children       ProductCategory[] @relation("CategoryParent")
  products       Product[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@map("product_categories")
}

/// Marca ou fabricante. Fica fora da taxonomia porque nao e um nivel dela: o mesmo grupo pode ter
/// varias marcas e a mesma marca aparece em grupos diferentes.
model ProductBrand {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(40)
  name           String       @db.VarChar(120)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products       Product[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@map("product_brands")
}

/// Eixo de classificacao tecnica, criado pelo proprio tenant. Existe porque os eixos variam por
/// linha de produto: tubo tem schedule, aluminio tem tempera, aco carbono nao tem nenhum dos dois.
/// Colunas fixas obrigariam uma migration a cada eixo novo. Ver ADR-0010.
model ProductAttributeDefinition {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  code           String                   @db.VarChar(40)
  name           String                   @db.VarChar(120)
  active         Boolean                  @default(true)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  options        ProductAttributeOption[]
  assignments    ProductAttribute[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@map("product_attribute_definitions")
}

/// Valor permitido de um eixo. Enumeracao controlada, nunca texto livre: facetas servem para
/// agrupar e buscar, e nao entram em calculo.
model ProductAttributeOption {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  definitionId   String                     @map("definition_id") @db.Uuid
  code           String                     @db.VarChar(40)
  name           String                     @db.VarChar(120)
  active         Boolean                    @default(true)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  definition     ProductAttributeDefinition @relation(fields: [definitionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignments    ProductAttribute[]

  @@unique([id, organizationId])
  @@unique([id, definitionId, organizationId])
  @@unique([organizationId, definitionId, code])
  @@index([organizationId, definitionId])
  @@map("product_attribute_options")
}

/// Faceta atribuida a um produto. A unicidade (product_id, definition_id) garante no maximo um
/// valor por eixo: um produto nao e 1020 e 1045 ao mesmo tempo.
model ProductAttribute {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  productId      String                     @map("product_id") @db.Uuid
  definitionId   String                     @map("definition_id") @db.Uuid
  optionId       String                     @map("option_id") @db.Uuid
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product                    @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  definition     ProductAttributeDefinition @relation(fields: [definitionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  option         ProductAttributeOption     @relation(fields: [optionId, definitionId, organizationId], references: [id, definitionId, organizationId], onDelete: Restrict)

  @@unique([productId, definitionId])
  @@index([organizationId, optionId])
  @@map("product_attributes")
}

model Product {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  sku                  String                @db.VarChar(80)
  shortDescription     String                @map("short_description") @db.VarChar(240)
  technicalDescription String?               @map("technical_description") @db.Text
  baseUnitId           String                @map("base_unit_id") @db.Uuid
  categoryId           String?               @map("category_id") @db.Uuid
  brandId              String?               @map("brand_id") @db.Uuid
  // Geometria da ADR-0010: colunas proprias porque os valores entram em calculo de preco. Nulo
  // significa "nao se aplica a este produto" e nunca zero, que seria uma medida real. Dimensoes
  // sempre em milimetro, a unidade canonica; polegada e apresentacao, convertida na interface.
  thicknessMm          Decimal?              @map("thickness_mm") @db.Decimal(24, 10)
  widthMm              Decimal?              @map("width_mm") @db.Decimal(24, 10)
  heightMm             Decimal?              @map("height_mm") @db.Decimal(24, 10)
  outerDiameterMm      Decimal?              @map("outer_diameter_mm") @db.Decimal(24, 10)
  innerDiameterMm      Decimal?              @map("inner_diameter_mm") @db.Decimal(24, 10)
  lengthMm             Decimal?              @map("length_mm") @db.Decimal(24, 10)
  // Peso teorico informado pelas tabelas do fornecedor. O sistema nao deriva peso de densidade e
  // geometria enquanto a formula nao for validada por engenharia (ADR-0010).
  weightPerMeterKg     Decimal?              @map("weight_per_meter_kg") @db.Decimal(24, 10)
  weightPerSquareMeterKg Decimal?            @map("weight_per_square_meter_kg") @db.Decimal(24, 10)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  baseUnit             UnitOfMeasure         @relation("ProductBaseUnit", fields: [baseUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  category             ProductCategory?      @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  brand                ProductBrand?         @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  presentations        ProductPresentation[]
  attributes           ProductAttribute[]

  @@unique([id, organizationId])
  @@unique([organizationId, sku])
  @@index([organizationId, shortDescription])
  @@index([organizationId, categoryId])
  @@index([organizationId, brandId])
  @@map("products")
}

model ProductPresentation {
  id                      String                             @id @default(uuid()) @db.Uuid
  organizationId          String                             @map("organization_id") @db.Uuid
  productId               String                             @map("product_id") @db.Uuid
  unitOfMeasureId         String                             @map("unit_of_measure_id") @db.Uuid
  code                    String                             @db.VarChar(80)
  name                    String                             @db.VarChar(160)
  conversionMode          ProductConversionMode              @map("conversion_mode")
  conversionFactor        Decimal?                           @map("conversion_factor") @db.Decimal(24, 10)
  active                  Boolean                            @default(true)
  createdAt               DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization            Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product                 Product                            @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  unitOfMeasure           UnitOfMeasure                      @relation("PresentationUnit", fields: [unitOfMeasureId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplierProductMappings SupplierProductMapping[]
  fiscalDocumentMappings  InboundFiscalDocumentItemMapping[]

  @@unique([id, organizationId])
  @@unique([organizationId, productId, code])
  @@index([organizationId, unitOfMeasureId])
  @@map("product_presentations")
}

model SupplierProductMapping {
  id                     String              @id @default(uuid()) @db.Uuid
  organizationId         String              @map("organization_id") @db.Uuid
  supplierId             String              @map("supplier_id") @db.Uuid
  productPresentationId  String              @map("product_presentation_id") @db.Uuid
  supplierCode           String              @map("supplier_code") @db.VarChar(120)
  normalizedSupplierCode String              @map("normalized_supplier_code") @db.VarChar(120)
  active                 Boolean             @default(true)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier               Partner             @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  productPresentation    ProductPresentation @relation(fields: [productPresentationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, supplierId, normalizedSupplierCode])
  @@index([organizationId, productPresentationId])
  @@map("supplier_product_mappings")
}

model InboundFiscalDocument {
  id                String                          @id @default(uuid()) @db.Uuid
  organizationId    String                          @map("organization_id") @db.Uuid
  accessKey         String                          @map("access_key") @db.VarChar(44)
  status            FiscalDocumentStatus            @default(PENDING_VALIDATION)
  validationIssues  FiscalDocumentValidationIssue[] @default([]) @map("validation_issues")
  schemaVersion     String                          @map("schema_version") @db.VarChar(10)
  documentNumber    String                          @map("document_number") @db.VarChar(20)
  series            String                          @db.VarChar(10)
  protocol          String?                         @db.VarChar(32)
  issuedAt          DateTime                        @map("issued_at") @db.Timestamptz(3)
  supplierTaxId     String                          @map("supplier_tax_id") @db.VarChar(32)
  supplierName      String                          @map("supplier_name") @db.VarChar(160)
  recipientTaxId    String                          @map("recipient_tax_id") @db.VarChar(32)
  natureOfOperation String                          @map("nature_of_operation") @db.VarChar(255)
  documentTotal     Decimal                         @map("document_total") @db.Decimal(24, 4)
  createdAt         DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items             InboundFiscalDocumentItem[]
  ingestions        FiscalDocumentIngestion[]

  @@unique([id, organizationId])
  @@unique([organizationId, accessKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, supplierTaxId, issuedAt])
  @@map("inbound_fiscal_documents")
}

model InboundFiscalDocumentItem {
  id                     String                            @id @default(uuid()) @db.Uuid
  organizationId         String                            @map("organization_id") @db.Uuid
  documentId             String                            @map("document_id") @db.Uuid
  itemNumber             String                            @map("item_number") @db.VarChar(16)
  supplierCode           String                            @map("supplier_code") @db.VarChar(120)
  description            String                            @db.VarChar(240)
  ncm                    String                            @db.VarChar(8)
  cest                   String?                           @db.VarChar(7)
  gtin                   String?                           @db.VarChar(14)
  cfop                   String                            @db.VarChar(4)
  commercialUnit         String                            @map("commercial_unit") @db.VarChar(16)
  commercialQuantity     Decimal                           @map("commercial_quantity") @db.Decimal(24, 10)
  commercialUnitValue    Decimal                           @map("commercial_unit_value") @db.Decimal(24, 10)
  taxableUnit            String                            @map("taxable_unit") @db.VarChar(16)
  taxableQuantity        Decimal                           @map("taxable_quantity") @db.Decimal(24, 10)
  taxableUnitValue       Decimal                           @map("taxable_unit_value") @db.Decimal(24, 10)
  totalValue             Decimal                           @map("total_value") @db.Decimal(24, 4)
  createdAt              DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  organization           Organization                      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document               InboundFiscalDocument             @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  internalProductMapping InboundFiscalDocumentItemMapping?
  tax                    InboundFiscalDocumentItemTax?

  @@unique([id, organizationId])
  @@unique([organizationId, documentId, itemNumber])
  @@index([organizationId, supplierCode])
  @@map("inbound_fiscal_document_items")
}

/// Transcricao do grupo `imposto` de um item da NF-e: o que o emitente declarou, nunca o que este
/// sistema calcula. Todos os campos sao opcionais porque os grupos variam conforme CST, CSOSN e
/// regime, e porque os dois regimes coexistem durante a transicao da reforma. O que nao esta
/// projetado aqui continua recuperavel no XML original preservado no object storage.
model InboundFiscalDocumentItemTax {
  id                    String                    @id @default(uuid()) @db.Uuid
  organizationId        String                    @map("organization_id") @db.Uuid
  documentItemId        String                    @map("document_item_id") @db.Uuid
  origin                String?                   @db.VarChar(1)
  icmsCst               String?                   @map("icms_cst") @db.VarChar(2)
  icmsCsosn             String?                   @map("icms_csosn") @db.VarChar(3)
  /// Codigo de Beneficio Fiscal. Exigido em SP desde a Portaria SRE 70/2025; depende da operacao,
  /// nao do produto, por isso vive no snapshot do documento.
  icmsBenefitCode       String?                   @map("icms_benefit_code") @db.VarChar(10)
  icmsBase              Decimal?                  @map("icms_base") @db.Decimal(24, 4)
  icmsRate              Decimal?                  @map("icms_rate") @db.Decimal(9, 4)
  icmsValue             Decimal?                  @map("icms_value") @db.Decimal(24, 4)
  icmsBaseReductionRate Decimal?                  @map("icms_base_reduction_rate") @db.Decimal(9, 4)
  icmsStBase            Decimal?                  @map("icms_st_base") @db.Decimal(24, 4)
  icmsStValue           Decimal?                  @map("icms_st_value") @db.Decimal(24, 4)
  ipiCst                String?                   @map("ipi_cst") @db.VarChar(2)
  ipiRate               Decimal?                  @map("ipi_rate") @db.Decimal(9, 4)
  ipiValue              Decimal?                  @map("ipi_value") @db.Decimal(24, 4)
  pisCst                String?                   @map("pis_cst") @db.VarChar(2)
  pisValue              Decimal?                  @map("pis_value") @db.Decimal(24, 4)
  cofinsCst             String?                   @map("cofins_cst") @db.VarChar(2)
  cofinsValue           Decimal?                  @map("cofins_value") @db.Decimal(24, 4)
  /// Grupo IBSCBS da NT 2025.002, ausente nas notas de emitentes ainda nao obrigados.
  ibsCbsCst             String?                   @map("ibs_cbs_cst") @db.VarChar(3)
  ibsCbsClassification  String?                   @map("ibs_cbs_classification") @db.VarChar(6)
  ibsCbsBase            Decimal?                  @map("ibs_cbs_base") @db.Decimal(24, 4)
  ibsValue              Decimal?                  @map("ibs_value") @db.Decimal(24, 4)
  cbsValue              Decimal?                  @map("cbs_value") @db.Decimal(24, 4)
  approximateTaxValue   Decimal?                  @map("approximate_tax_value") @db.Decimal(24, 4)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentItem          InboundFiscalDocumentItem @relation(fields: [documentItemId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([documentItemId, organizationId])
  @@map("inbound_fiscal_document_item_taxes")
}

model FiscalDocumentIngestion {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  documentId         String                @map("document_id") @db.Uuid
  source             FiscalIngestionSource
  hashSha256         String                @map("hash_sha256") @db.VarChar(64)
  idempotencyKeyHash String                @map("idempotency_key_hash") @db.VarChar(64)
  objectKey          String                @map("object_key") @db.VarChar(1024)
  objectVersionId    String?               @map("object_version_id") @db.VarChar(1024)
  contentType        String                @map("content_type") @db.VarChar(100)
  byteSize           BigInt                @map("byte_size")
  requestId          String                @map("request_id") @db.VarChar(80)
  correlationId      String                @map("correlation_id") @db.VarChar(128)
  ingestedAt         DateTime              @default(now()) @map("ingested_at") @db.Timestamptz(3)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document           InboundFiscalDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, documentId, hashSha256])
  @@unique([organizationId, idempotencyKeyHash])
  @@unique([organizationId, objectKey])
  @@index([organizationId, ingestedAt])
  @@map("fiscal_document_ingestions")
}

model InboundFiscalDocumentItemMapping {
  id                    String                    @id @default(uuid()) @db.Uuid
  organizationId        String                    @map("organization_id") @db.Uuid
  documentItemId        String                    @map("document_item_id") @db.Uuid
  productPresentationId String                    @map("product_presentation_id") @db.Uuid
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentItem          InboundFiscalDocumentItem @relation(fields: [documentItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  productPresentation   ProductPresentation       @relation(fields: [productPresentationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([documentItemId, organizationId])
  @@index([organizationId, productPresentationId])
  @@map("inbound_fiscal_document_item_mappings")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions       Session[]

  @@unique([organizationId, userId])
  @@unique([id, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Session {
  id           String     @id @default(uuid()) @db.Uuid
  tokenHash    String     @unique @map("token_hash") @db.VarChar(64)
  userId       String     @map("user_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt   DateTime?  @map("last_used_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([membershipId, expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String       @db.VarChar(120)
  entityType     String       @map("entity_type") @db.VarChar(120)
  entityId       String?      @map("entity_id") @db.VarChar(160)
  requestId      String       @map("request_id") @db.VarChar(80)
  correlationId  String       @map("correlation_id") @db.VarChar(128)
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

model IdempotencyRecord {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  operation      String       @db.VarChar(120)
  key            String       @db.VarChar(128)
  requestHash    String       @map("request_hash") @db.VarChar(64)
  responseStatus Int?         @map("response_status")
  responseBody   Json?        @map("response_body")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
