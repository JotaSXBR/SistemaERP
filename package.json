{
  "name": "sistema-erp",
  "version": "0.0.0",
  "private": true,
  "description": "ERP web multiempresa em monorepo TypeScript",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "build": "pnpm db:generate && pnpm --recursive --if-present run build",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- packages/contracts/openapi packages/contracts/src/generated",
    "contracts:generate": "pnpm --filter @sistema-erp/api openapi:export && pnpm --filter @sistema-erp/contracts generate",
    "db:generate": "pnpm --filter @sistema-erp/database db:generate",
    "db:migrate": "pnpm --filter @sistema-erp/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @sistema-erp/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @sistema-erp/database db:migrate:status",
    "db:seed": "pnpm --filter @sistema-erp/database db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --follow postgres",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up --detach --wait",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && tsc --project tsconfig.json --noEmit && pnpm --recursive --if-present run typecheck",
    "test": "pnpm db:generate && pnpm --recursive --if-present run test",
    "test:e2e": "pnpm --recursive --if-present run test:e2e",
    "test:e2e:install": "pnpm --filter @sistema-erp/web exec playwright install --with-deps chromium",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm contracts:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
