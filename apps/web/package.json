{
  "name": "@sistema-erp/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit && vite build",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "pnpm --filter @sistema-erp/contracts build",
    "predev": "pnpm --filter @sistema-erp/contracts build",
    "pretest": "pnpm --filter @sistema-erp/contracts build",
    "pretypecheck": "pnpm --filter @sistema-erp/contracts build",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sistema-erp/contracts": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
