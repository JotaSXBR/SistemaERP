# PostgreSQL local — use somente valores de desenvolvimento.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sistema_erp
POSTGRES_USER=sistema_erp
POSTGRES_PASSWORD=local_development_only

# Consumida pelo Prisma e pela readiness da API.
DATABASE_URL=postgresql://sistema_erp:local_development_only@localhost:5432/sistema_erp?schema=public

# API HTTP local.
API_HOST=0.0.0.0
API_PORT=3000
