# PostgreSQL local — use somente valores de desenvolvimento.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sistema_erp
POSTGRES_USER=sistema_erp
POSTGRES_PASSWORD=local_development_only

# Consumida pelo Prisma e pela readiness da API.
DATABASE_URL=postgresql://sistema_erp:local_development_only@localhost:5432/sistema_erp?schema=public

# MinIO local — credencial administrativa usada somente pelo provisionamento do Compose.
MINIO_ROOT_USER=sistema_erp_admin
MINIO_ROOT_PASSWORD=local_minio_admin_only
MINIO_BUCKET=sistema-erp-private
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_APP_USER=sistema_erp_app
MINIO_APP_PASSWORD=local_minio_app_only

# Acesso runtime da API ao storage privado local. Em produção, use credencial de privilégio mínimo.
S3_ACCESS_KEY_ID=sistema_erp_app
S3_SECRET_ACCESS_KEY=local_minio_app_only
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=sistema-erp-private
S3_FORCE_PATH_STYLE=true

# Credencial exclusivamente local criada pelo seed da Fase 7.
SEED_ADMIN_PASSWORD=local_admin_only

# API HTTP local.
API_HOST=0.0.0.0
API_PORT=3000

# URL pública opcional da API para o bundle web. Vazio usa a mesma origem.
VITE_API_BASE_URL=
